datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../frontend/src/generated/prisma"
}

generator backend_client {
  provider = "prisma-client-js"
  output   = "../backend/src/generated/prisma"
}

model Conversation {
  id        String          @id @default(uuid())
  userId    String?         @map("user_id")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @default(now()) @updatedAt @map("updated_at")
  status    String          @default("active")
  messages  Message[]
  feedback  Feedback?
  gestures  GestureMetrics?

  @@index([userId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  createdAt      DateTime     @default(now()) @map("created_at")
  role           String
  content        String
  audioUrl       String?      @map("audio_url")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("messages")
}

model Feedback {
  id                       String       @id @default(uuid())
  conversationId           String       @unique @map("conversation_id")
  createdAt                DateTime     @default(now()) @map("created_at")
  goodPoints               String       @map("good_points")
  improvementPoints        String       @map("improvement_points")
  overallScore             Int?         @map("overall_score")
  conversationScore        Int?         @map("conversation_score")
  gestureScore             Int?         @map("gesture_score")
  voiceScore               Int?         @map("voice_score")
  gestureGoodPoints        String?      @map("gesture_good_points")
  gestureImprovementPoints String?      @map("gesture_improvement_points")
  voiceMetrics             Json?        @map("voice_metrics")
  adviceScoreAdded         Int?         @map("advice_score_added") // アドバイス達成による加点
  adviceUnfulfilled        String?      @map("advice_unfulfilled") // 未達成アドバイス一覧（改行区切り）
  conversation             Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

model GestureMetrics {
  id                String       @id @default(uuid())
  conversationId    String       @unique @map("conversation_id")
  totalSamples      Int          @default(0) @map("total_samples")
  smilingSamples    Int          @default(0) @map("smiling_samples")
  smileIntensityAvg Float        @default(0) @map("smile_intensity_avg")
  smileIntensityMax Float        @default(0) @map("smile_intensity_max")
  gazeScoreAvg      Float        @default(0) @map("gaze_score_avg")
  lookingSamples    Int          @default(0) @map("looking_samples")
  gazeUpSamples     Int          @default(0) @map("gaze_up_samples")
  gazeDownSamples   Int          @default(0) @map("gaze_down_samples")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")
  conversation      Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("gesture_metrics")
}

// 人間パートナー（実際の女の子）とのビデオ通話セッション
model HumanPartnerSession {
  id        String    @id @default(uuid())
  userId    String    @map("user_id") // 練習者のID
  partnerId String    @map("partner_id") // パートナー（女の子）のID
  status    String    @default("waiting") // waiting, active, completed, cancelled
  roomId    String?   @unique @map("room_id") // ビデオ通話のルームID
  startedAt DateTime? @map("started_at") // セッション開始時刻
  endedAt   DateTime? @map("ended_at") // セッション終了時刻
  duration  Int? // セッション時間（秒）
  rating    Int? // セッション後の評価（1-5）
  notes     String?   @db.Text // セッションメモ
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at")

  // リレーション
  user         User                  @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  partner      User                  @relation("PartnerSessions", fields: [partnerId], references: [id], onDelete: Cascade)
  feedback     HumanPartnerFeedback?
  practiceSlot PracticeSlot?

  @@index([userId])
  @@index([partnerId])
  @@index([status])
  @@map("human_partner_sessions")
}

// 人間パートナーセッションのフィードバック
model HumanPartnerFeedback {
  id        String   @id @default(uuid())
  sessionId String   @unique @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")

  // AIによる自動フィードバック
  aiGoodPoints        String? @map("ai_good_points")
  aiImprovementPoints String? @map("ai_improvement_points")
  aiOverallScore      Int?    @map("ai_overall_score")

  // パートナーからの手動フィードバック
  partnerGoodPoints        String? @map("partner_good_points")
  partnerImprovementPoints String? @map("partner_improvement_points")
  partnerRating            Int?    @map("partner_rating") // 1-5
  partnerComment           String? @map("partner_comment")

  // リレーション
  session HumanPartnerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("human_partner_feedback")
}

model User {
  id            String  @id @default(cuid())
  name          String
  email         String  @unique
  emailVerified Boolean @default(false)
  image         String?
  role          String  @default("user") // user（一般ユーザー）, admin（管理者）, partner（パートナー）

  // パートナー用の追加情報
  bio           String? @db.Text // 自己紹介
  isAvailable   Boolean @default(false) @map("is_available") // パートナーとして対応可能か
  rating        Float? // 評価（1-5）
  totalSessions Int     @default(0) @map("total_sessions") // 総セッション数
  hourlyRate    Int?    @map("hourly_rate") // 時給（円）
  availableDays String? @map("available_days") @db.Text // 対応可能な曜日（JSON形式）
  languages     String? @db.Text // 対応可能な言語（カンマ区切り）
  specialties   String? @db.Text // 専門分野（カンマ区切り）

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  accounts        Account[]
  sessions        Session[]
  userSessions    HumanPartnerSession[] @relation("UserSessions")
  partnerSessions HumanPartnerSession[] @relation("PartnerSessions")
  partnerSlots    PracticeSlot[]        @relation("PartnerSlots")
  bookedSlots     PracticeSlot[]        @relation("BookedSlots")

  @@index([role])
  @@index([isAvailable])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([identifier])
}

// パートナーが開放する練習枠
model PracticeSlot {
  id             String    @id @default(uuid())
  partnerId      String    @map("partner_id") // パートナーのID
  startTime      DateTime  @map("start_time") // 開始時刻
  endTime        DateTime  @map("end_time") // 終了時刻
  status         String    @default("available") // available, booked, completed, cancelled
  bookedByUserId String?   @map("booked_by_user_id") // 予約したユーザーのID
  bookedAt       DateTime? @map("booked_at") // 予約日時
  price          Int       @default(1000) // 価格（円）
  sessionId      String?   @unique @map("session_id") // セッションIDへの参照
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  // リレーション
  partner      User                 @relation("PartnerSlots", fields: [partnerId], references: [id], onDelete: Cascade)
  bookedByUser User?                @relation("BookedSlots", fields: [bookedByUserId], references: [id], onDelete: SetNull)
  session      HumanPartnerSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([bookedByUserId])
  @@index([status])
  @@index([startTime])
  @@map("practice_slots")
}
